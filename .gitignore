node_modules/

# Generated build artifacts per implementation
problems/**/*.dtr
problems/**/*.agdai
problems/**/jAgda.*.js
problems/**/agda-rts.js
problems/**/build/

# Dafny: only the source .dfy is checked in; the compiled .js is regenerated.
# (The .js next to each .dfy is the build output.)
problems/*/dafny/*.js
capabilities/dafny/*.js
capabilities/dafny/*.dtr

# Capabilities directory: same conventions as problems/.
capabilities/*/jAgda.*.js
capabilities/*/agda-rts.js
capabilities/*/*.agdai
capabilities/*/build/

# Coq → OCaml → js_of_ocaml pipeline artifacts (regenerated from .v + driver.ml).
# driver.ml is hand-written and tracked; the extracted .ml/.mli (matching the
# .v stem, lowercased) is regenerated by coqc and is *not* tracked.
problems/*/coq/.*.aux
problems/*/coq/.*.cache
problems/*/coq/*.vo
problems/*/coq/*.glob
problems/*/coq/*.cmo
problems/*/coq/*.cmi
problems/*/coq/*.byte
problems/*/coq/*.js
problems/factorial/coq/factorial.ml
problems/factorial/coq/factorial.mli
problems/reverse/coq/reverse.ml
problems/reverse/coq/reverse.mli
problems/insertion-sort/coq/insertionsort.ml
problems/insertion-sort/coq/insertionsort.mli
problems/vec-zipwith/coq/veczipwith.ml
problems/vec-zipwith/coq/veczipwith.mli
problems/sum-formula/coq/sumformula.ml
problems/sum-formula/coq/sumformula.mli

capabilities/coq/.*.aux
capabilities/coq/.*.cache
capabilities/coq/*.vo
capabilities/coq/*.glob
capabilities/coq/*.cmo
capabilities/coq/*.cmi
capabilities/coq/*.byte
capabilities/coq/*.js
capabilities/coq/caps.ml
capabilities/coq/caps.mli

# Generator outputs (regenerable)
outputs/
